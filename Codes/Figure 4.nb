Cell[BoxData[
 RowBox[{
  RowBox[{"UNonMarkovianfunctionXX", "[", 
   RowBox[{
   "\[Gamma]_", ",", "T_", ",", "\[CapitalDelta]t_", ",", "\[Delta]_"}], 
   "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "\[CapitalNu]", ",", "gDown", ",", "gUp", ",", "H0NonMarkovian", ",", 
      "HIdownNonMarkovian", ",", "\[Omega]", ",", "HIupNonMarkovian", ",", 
      "UAA", ",", "USATotalNonMarkovian"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"\[Omega]", "=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[CapitalNu]", "=", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"\[Omega]", "/", "T"}], "]"}], "-", "1"}], ")"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gDown", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[Gamma]", " ", 
        RowBox[{"(", 
         RowBox[{"\[CapitalNu]", "+", "1"}], ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"gUp", "=", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"\[Gamma]", " ", 
        RowBox[{"(", "\[CapitalNu]", ")"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"H0NonMarkovian", "=", 
      RowBox[{"kron", "[", 
       RowBox[{
        RowBox[{"\[Sigma]z", "/", "2"}], ",", 
        RowBox[{"\[Sigma]z", "/", "2"}], ",", 
        RowBox[{"\[Sigma]z", "/", "2"}], ",", 
        RowBox[{"\[Sigma]z", "/", "2"}], ",", 
